+namespace aurora::webgpu {
+/// A texture rendering into `ioSurface` (IOSurfaceRef), shared with the host that made it.
+bool import_iosurface(const wgpu::Device& device, void* ioSurface, wgpu::SharedTextureMemory& memory,
+                      wgpu::Texture& texture) {
+  wgpu::SharedTextureMemoryIOSurfaceDescriptor ioSurfaceDesc;
+  ioSurfaceDesc.ioSurface = ioSurface;
+  const wgpu::SharedTextureMemoryDescriptor memoryDesc{
+      .nextInChain = &ioSurfaceDesc,
+      .label = "Present target",
+  };
+  memory = device.ImportSharedTextureMemory(&memoryDesc);
+  if (!memory) {
+    return false;
+  }
+  wgpu::SharedTextureMemoryProperties properties;
+  memory.GetProperties(&properties);
+  const wgpu::TextureDescriptor textureDesc{
+      .label = "Present target",
+      .usage = wgpu::TextureUsage::RenderAttachment,
+      .dimension = wgpu::TextureDimension::e2D,
+      .size = properties.size,
+      .format = properties.format,
+      .mipLevelCount = 1,
+      .sampleCount = 1,
+  };
+  texture = memory.CreateTexture(&textureDesc);
+  return static_cast<bool>(texture);
+}
+} // namespace aurora::webgpu
