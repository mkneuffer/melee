{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/${presetName}/install"
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "native",
      "displayName": "Native",
      "description": "32-bit host build against aurora",
      "inherits": [
        "base"
      ],
      "toolchainFile": "${sourceDir}/cmake/i686-gcc.cmake"
    },
    {
      "name": "ppc-dwarf",
      "displayName": "PPC DWARF",
      "description": "32-bit big-endian PowerPC build emitting DWARF type information",
      "inherits": [
        "debug",
        "base"
      ],
      "toolchainFile": "${sourceDir}/cmake/ppc32-clang.cmake",
      "cacheVariables": {
        "MELEE_DWARF": {
          "type": "BOOL",
          "value": true
        }
      }
    },
    {
      "name": "dat",
      "displayName": "Dat samples (GALE01)",
      "description": "The PPC DWARF build plus samples of the .dat archives' types, as an objdiff project in its build directory",
      "inherits": [
        "ppc-dwarf"
      ],
      "binaryDir": "${sourceDir}/build/GALE01/dat",
      "installDir": "${sourceDir}/build/GALE01/dat/install",
      "cacheVariables": {
        "MELEE_VERSION": "GALE01",
        "MELEE_DAT_SAMPLES": {
          "type": "BOOL",
          "value": true
        }
      }
    },
    {
      "name": "visionos",
      "displayName": "visionOS (Apple Vision Pro)",
      "description": "The native port and its app, as an Xcode project for the device",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/visionos",
      "toolchainFile": "${sourceDir}/cmake/visionos.cmake",
      "cacheVariables": {
        "MELEE_PORT": {
          "type": "BOOL",
          "value": true
        },
        "MELEE_VERSION": "GALE01"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "visionos-sim",
      "displayName": "visionOS Simulator",
      "description": "The native port and its app, for the visionOS simulator",
      "inherits": [
        "visionos"
      ],
      "binaryDir": "${sourceDir}/build/visionos-sim",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": "xrsimulator"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native",
      "configurePreset": "native"
    },
    {
      "name": "ppc-dwarf",
      "configurePreset": "ppc-dwarf"
    },
    {
      "name": "dat",
      "configurePreset": "dat"
    },
    {
      "name": "visionos",
      "configurePreset": "visionos",
      "configuration": "Debug"
    },
    {
      "name": "visionos-sim",
      "configurePreset": "visionos-sim",
      "configuration": "Debug"
    }
  ]
}
